--- atividades ---

--1
select 
	tx_nome 
from
	tb_clientes tc 
where
	fl_ativo is true
order by
	tx_nome desc;

--2

select
	sum(vl_cobranca) as total, 
	tx_mes
from
	tb_cobrancas tc
group by tx_mes
order by
	tx_mes asc;

--3

select
	sum (vl_cobranca) as total,
	tx_mes,
	cd_cliente
from
	tb_cobrancas tc
where tx_mes like '2026-10'
group by cd_cliente,  tx_mes
order by total desc;

--4
select
	tx_nome,
	sum (vl_cobranca) as total
	from tb_cobrancas co
inner join tb_clientes cli
on co.cd_cliente = cli.id_cliente 
where tx_mes = '2026-10' and vl_cobranca > (
	select avg(vl_cobranca) as media
	from tb_cobrancas)
group by tx_nome
order by total;